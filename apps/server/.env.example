# MongoDB connection string. Local dev: `docker compose up -d` at the repo root (this is the default).
# Atlas / hosted: mongodb+srv://user:pass@cluster.mongodb.net/uno-chess
MONGODB_URI=mongodb://localhost:27017/uno-chess

# Google sign-in: OAuth client ID from Google Cloud Console (Web application).
# Add http://localhost:3000 to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
# Long random string; without it, login tokens stop working after every server restart.
AUTH_SECRET=
